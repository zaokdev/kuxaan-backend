# Conexion a la base de datos MySQL
DATABASE_URL="mysql://usuario:contrasena@localhost:3306/kuxaan"

# Puerto del servidor
PUERTO=3000

# Clave secreta para firmar los tokens JWT
JWT_SECRETO="cambia-esta-clave-secreta"

# Tiempo de expiracion del token
JWT_EXPIRACION="8h"

# Carpeta donde se guardan los archivos de evidencias
CARPETA_EVIDENCIAS="uploads/evidencias"
